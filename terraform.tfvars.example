# Example Terraform Variables
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git!

# Required: Hetzner Cloud resource IDs
volume_id      = "12345678"  # Get from: hcloud volume list
primary_ip_id  = "87654321"  # Get from: hcloud floating-ip list

# Optional: SSH key path (default: ~/.ssh/id_rsa.pub)
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Optional: Domain name (default: cloud.sysmarketsa.com)
domain = "cloud.sysmarketsa.com"

# Optional: Server configuration
server_name = "worker0"
# server_type = "cx21"
# location    = "nbg1"

# Optional: Network configuration
network_cidr = "10.0.0.0/16"
subnet_cidr  = "10.0.1.0/24"

# Security: Restrict SSH access to specific IPs (strongly recommended!)
# Get your IP: curl ifconfig.me
# allowed_ssh_ips = ["YOUR_IP/32"]

# Optional: Admin email for notifications
#admin_email = "admin@cloud.sysmarketsa.com"

# Optional: Enable/disable fail2ban (default: true)
# enable_fail2ban = true
